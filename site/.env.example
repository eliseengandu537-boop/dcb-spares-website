# Copy to .env.local. Never commit credentials or put them in NEXT_PUBLIC_ variables.
# A DCB Google Workspace administrator supplies the sending connection.
# Use an authorised @dcbspares.co.za sending mailbox.
GMAIL_USER=
# Option A: Google app password (requires 2-Step Verification and admin approval).
# This is NOT the account's normal sign-in password.
GMAIL_APP_PASSWORD=
# Option B: OAuth2, if app passwords are disabled. Leave Option A blank.
# The refresh token must allow Gmail SMTP access (https://mail.google.com/).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
